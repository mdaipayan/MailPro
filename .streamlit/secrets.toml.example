# EXAMPLE ONLY. Do not put real values in this file.
#
# On Streamlit Community Cloud: open your app > Settings > Secrets, and paste
# your real version there. To make it, run on your own PC:
#
#     python tools/make_secrets.py
#
# On your own PC: save your real version as  .streamlit/secrets.toml
# (that file is in .gitignore and never goes to GitHub).

# Password that staff type to open the app. Use 16 or more characters.
app_password = "change-this-to-a-long-password"

# Letterhead and signature, as base64 text. They are NOT stored in GitHub.
[letter_images]
"Admit_card_background.png" = "iVBORw0KGgo...(long text made by tools/make_secrets.py)..."
"signAND-removebg-preview.png" = "iVBORw0KGgo...(long text)..."
